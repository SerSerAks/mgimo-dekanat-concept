# Скопируйте в .env и заполните. .env в git не попадает.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://dekanat:<пароль>@localhost:5433/dekanat
# Секрет для подписи QR-токена студенческого (32+ случайных символа)
APP_SECRET=
# Ключ ИИ-помощника (GigaChat / YandexGPT) — только на сервере, необязателен
AI_API_KEY=
